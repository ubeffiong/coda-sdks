{
  "name": "@coda-terminology/client",
  "version": "0.1.0",
  "description": "Client for the CODA clinical terminology API",
  "keywords": [
    "coda",
    "clinical-terminology",
    "icd-11",
    "snomed-ct",
    "loinc",
    "fhir",
    "medical-coding"
  ],
  "homepage": "https://github.com/ubeffiong/coda-sdks/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/ubeffiong/coda-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubeffiong/coda-sdks.git",
    "directory": "typescript"
  },
  "license": "Apache-2.0",
  "author": "CODA contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('dist/connect.js', '../../CODA-Web/public/connect.js')\"",
    "test": "npm run build && node --test test/client.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
